# ─── ÖNEMLİ ───────────────────────────────────────────────────────────────────
# Git push bu dosyayı CANLI ortama taşımaz!
# • Lokal:  bu dosyayı kopyalayıp .env.local yapın, Supabase'den gerçek değerleri yapıştırın
# • Vercel: Project → Settings → Environment Variables (Production + Preview + Development)
#
# Push sonrası "veritabanı kopması" = Vercel'de bu 3 değişken eksik veya yanlış demektir.

# Supabase (Settings → API — üçünü birlikte kopyalayın)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App encryption (32+ chars — Netgsm şifresi, PII için zorunlu prod'da)
APP_ENCRYPTION_KEY=change-me-to-a-long-random-string-min-32-chars

# Global SMS fallback (tenant ayarları yoksa)
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_HEADER=AURA

# E-posta
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# AI (plan 2+)
GEMINI_API_KEY=

# Süper admin e-postaları (virgülle ayrılmış)
SUPER_ADMIN_EMAILS=admin@aurabilisim.net,admin@aurabilisim.com

# Diagnostic endpoint koruması (production)
DEBUG_SECRET=

# Müşteri portalı — aurabilisim.net alt domain (yeni domain almanıza gerek yok)
# Ana uygulama: integra.aurabilisim.net → Vercel
# Portal kısa URL (opsiyonel): takip.aurabilisim.net → aynı Vercel projesi
# NEXT_PUBLIC_APP_URL=https://integra.aurabilisim.net
# NEXT_PUBLIC_PORTAL_BASE_URL=https://takip.aurabilisim.net
# NEXT_PUBLIC_PORTAL_HOST=takip.aurabilisim.net
# Alt domain yoksa: https://integra.aurabilisim.net/portal/[slug]

# Ödeme webhook doğrulama
IYZICO_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Rate limiting (Upstash Redis — opsiyonel lokal)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CAPTCHA (Cloudflare Turnstile — başvuru formu)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sentry (production hata izleme)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Billing checkout redirect + magic link redirect (Production zorunlu)
NEXT_PUBLIC_APP_URL=https://integra.aurabilisim.net

# Cron job koruması (trial / ödeme / randevu hatırlatmaları)
CRON_SECRET=

# Aura Bilişim cihaz talep köprüsü
AURA_BRIDGE_SECRET=
