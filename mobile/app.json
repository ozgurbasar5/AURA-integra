{
  "expo": {
    "name": "AURA İntegra",
    "slug": "aura-integra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "auraintegra",
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.aurabilisim.integra",
      "infoPlist": {
        "NSCameraUsageDescription": "Cihaz fotoğrafı çekmek için kamera erişimi gerekir.",
        "NSPhotoLibraryUsageDescription": "Cihaz fotoğraflarını servis kaydına eklemek için galeri erişimi gerekir."
      }
    },
    "android": {
      "package": "net.aurabilisim.integra",
      "adaptiveIcon": {
        "backgroundColor": "#0e5568",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cihaz fotoğraflarını servis kaydına eklemek için galeri erişimi gerekir.",
          "cameraPermission": "Cihaz fotoğrafı çekmek için kamera erişimi gerekir."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0e5568"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://192.168.1.31:3000"
    }
  }
}
