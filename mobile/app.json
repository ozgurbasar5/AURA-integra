{
  "expo": {
    "name": "AURA Integra",
    "slug": "aura-integra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "auraintegra",
    "userInterfaceStyle": "automatic",
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.aurabilisim.integra",
      "infoPlist": {
        "NSCameraUsageDescription": "Cihaz fotoğrafı çekmek için kamera erişimi gerekir.",
        "NSPhotoLibraryUsageDescription": "Cihaz fotoğraflarını servis kaydına eklemek için galeri erişimi gerekir."
      }
    },
    "android": {
      "package": "net.aurabilisim.integra",
      "adaptiveIcon": {
        "backgroundColor": "#0e5568",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-system-ui",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cihaz fotoğraflarını servis kaydına eklemek için galeri erişimi gerekir.",
          "cameraPermission": "Cihaz fotoğrafı çekmek için kamera erişimi gerekir."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Barkod ve IMEI taraması için kamera erişimi gerekir.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0e5568"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0e5568"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      "./plugins/withAndroidBuildConfig"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://integra.aurabilisim.net",
      "eas": {
        "projectId": "b677e1a8-f4d2-411d-8907-4439cd6bc69c"
      }
    },
    "owner": "bsr870",
    "runtimeVersion": "1.0.0"
  }
}
